{
  "id": "back-navigation",
  "kind": "component",
  "title": "Back navigation",
  "aliases": [
    "back",
    "go back",
    "return",
    "Story library",
    "top left",
    "4k"
  ],
  "sources": [
    "../theme/components.mjs",
    "../theme/recipes.css"
  ],
  "consumers": [
    "All five stories"
  ],
  "parents": [
    "navigation",
    "responsive-scale"
  ],
  "guidance": [
    "Use one quiet page-level return at a consistent top-left position. Increase legibility on wide desktop displays without making it compete with the task. Remove redundant return buttons in cards."
  ],
  "decisions": [
    {
      "title": "One quiet return in the top-left page lead-in",
      "reason": "Detail, recovery and unavailable screens keep the same return position. Remove duplicate loud return buttons when the top-left return already supplies the route."
    },
    {
      "title": "Readable on large displays",
      "reason": "The label uses 1rem and inherits bounded viewport scale plus explicit text enlargement. Sign-in/role recovery returns to the workspace instead of exposing a private list."
    },
    {
      "title": "One return atom, including card examples",
      "reason": "backLink always emits cu-back-link; inside is metadata only. Useful forward navigation uses an action variant rather than a return-link styling exception."
    }
  ],
  "parameters": [
    {
      "name": "Back link",
      "tokens": [
        "text.back",
        "text.weight.back"
      ],
      "description": "1rem label,1.125em chevron, comfortable hit area and visible focus.",
      "source": "../theme/theme.json"
    },
    {
      "name": "Page spacing",
      "description": "Use the existing page-return/page-back wrapper; let long labels wrap intrinsically.",
      "source": "../theme/recipes.css"
    }
  ],
  "status": {
    "human": "feedback received; current revision awaits review",
    "implementation": "1.9 local HTML implementation and specified checks passed; application adoption separate",
    "visual": "Independent normal composition across all94 named states in both themes/mobile/desktop, plus selected native child/parent/page and stress/live scopes. Individual captured-only pixels remain unvisited; see1.9 coverage.",
    "color": "Purple rejected. Replacement slate-blue/blue-teal palette awaiting human judgment"
  },

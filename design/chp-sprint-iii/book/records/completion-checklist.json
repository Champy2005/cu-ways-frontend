  "guidance": [
    "Keep the overall task composition. Strengthen the minimal met-requirement signal and distinguish section headings from item headings. Refine empty-evidence spacing."
  ],
  "decisions": [
    {
      "title": "Section titles and item headings are distinct",
      "reason": "Section heading1.125rem, item weight/size subordinate, empty-state title1rem normal weight. Remove explanations that simply repeat met conditions."
    },
    {
      "title": "Checks remain minimal but visible",
      "reason": "Met checks use the semantic success ink,1.25em size and2.2 stroke. Keep meaningful missing-proof/payment/offer explanations."
    },
    {
      "title": "Evidence uses the shared attachment/link pattern",
      "reason": "Proof tag, destination and date remain distinct. The empty state retains the important rule that Brief/Other do not replace Proof."
    },
    {
      "title": "Name unmet conditions without asserting the current state",
      "reason": "In Progress status is a requirement label; an Accepted entity must not appear to assert that work is already In Progress. Actual lifecycle badge remains canonical."
    }
  ],
  "parameters": [
    {
      "name": "Met criterion",
      "tokens": [
        "color.status.success.ink"
      ],
      "description": "No extra decorative success backgrounds.",
      "source": "../theme/theme.json"
    },
    {
      "name": "Checklist/evidence",
      "description": "Task grid separates requirements and evidence; narrow enlarged empty evidence stacks its icon above copy.",
      "source": "../stories/screen.css"
    }
  ],
  "status": {
    "human": "feedback received; current revision awaits review",
    "implementation": "1.9 local HTML implementation and specified checks passed; application adoption separate",
    "visual": "Independent normal composition across all94 named states in both themes/mobile/desktop, plus selected native child/parent/page and stress/live scopes. Individual captured-only pixels remain unvisited; see1.9 coverage.",
